# Copy to .env to override. Everything has a working default.

# Which model answers: ollama:<model> (default ollama:qwen3:8b), openai:<model>,
# anthropic:<model>, or demo (a deterministic stand-in; no model needed).
GA_MODEL=ollama:qwen3:8b
OLLAMA_HOST=http://host.docker.internal:11434
GA_OLLAMA_THINK=0

# Only needed for the optional hosted providers.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Host ports, if the defaults are taken.
API_PORT=8000
WEB_PORT=3000
PG_PORT=5432
MCP_PORT=8001
JAEGER_PORT=16686
